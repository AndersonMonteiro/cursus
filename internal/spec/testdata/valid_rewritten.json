{"memory":{},"guardrails":{"output":[],"input":[]},
 "policies":{"sensitive_operations":{},"approval":{}},
 "allowlists":{"domains":["loyalty.example.com","orders.example.com","loyalty.example.com"]},
 "tools":{
  "grant_points":{
   "untrusted_output":false,"private_data":false,
   "effect":{"sensitive":{"unit":{"const":"points"},"quantity":"/points"},"kind":"write"},
   "output_schema":true,
   "input_schema":{"required":["order_id","points"],
    "properties":{"points":{"type":"integer"},"order_id":{"type":"string"}},"type":"object"},
   "description":"Adds loyalty points to the account that placed an order.","type":"http"},
  "refund_order":{
   "untrusted_output":false,"private_data":false,
   "effect":{"sensitive":{"unit":{"pointer":"\/currency"},"quantity":"/amount"},"kind":"write"},
   "output_schema":{"required":["refund_id"],"properties":{"refund_id":{"type":"string"}},"type":"object"},
   "input_schema":{"required":["order_id","amount","currency"],
    "properties":{"currency":{"type":"string"},"amount":{"type":"integer"},"order_id":{"type":"string"}},
    "type":"object"},
   "description":"Refunds part or all of one order.","type":"http"},
  "lookup_order":{
   "untrusted_output":false,"private_data":true,"effect":{"kind":"read"},
   "output_schema":{"required":["status","total"],
    "properties":{"total":{"type":"integer"},"status":{"type":"string"}},"type":"object"},
   "input_schema":{"required":["order_id"],"properties":{"order_id":{"type":"string"}},"type":"object"},
   "description":"Reads one order by its identifier.","type":"http"}},
 "budgets":{"max_cost":{"currency":"USD","amount":150},"max_steps":12},
 "untrusted_inputs":["run_input","run_input"],
 "risk_tier":"medium",
 "model":{"parameters":{"max_tokens":1024,"temperature":2.0e-1},"id":"example-model-2026-01-15","provider":"example"},
 "run":{"shape":"task"},
 "instructions":"Look the order up before answering. Never refund more than the order total.",
 "task":{"success_criterion":"The answer cites the order status, and a refund is issued only for an order the rule covers.",
  "description":"Answer a question about one order and refund it when the refund rule allows."},
 "name":"order-helper",
 "format":"cursus.agent/v1"}
